# Copy to terraform.tfvars and fill in actual values.
# Never commit terraform.tfvars to source control.

environment = "prod"

terraform_role_arn = ""

# VPC and subnet: use vpc-assessment.yaml CloudFormation outputs after BPI-MS approval.
vpc_id    = "vpc-xxxxxxxxxxxxxxxxx"
subnet_id = "subnet-xxxxxxxxxxxxxxxxx"
subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy",
]

availability_zone = "ap-southeast-1a"

github_org  = ""
github_repo = "cdcu"

sso_principal_arns = []

enable_kms    = true
sns_topic_arn = "arn:aws:sns:ap-southeast-1:123456789012:cdcu-prod-alerts"

data_lake_bucket_name      = "bpims-cdcu-prod-data-lake"
athena_results_bucket_name = "bpims-cdcu-prod-athena-results"

glue_worker_count = 10
glue_worker_type  = "G.1X"

# BPI-MS merged source DB used by the single CDCU Glue JDBC connection.
merged_jdbc_url              = "jdbc:mysql://merged-rds-endpoint.example.com:3306/cdcu_db?useSSL=false&allowPublicKeyRetrieval=true"
merged_mysql_secret_name     = "cdcu/prod/merged-mysql-connection"
mysql_jdbc_driver_class_name = ""
mysql_jdbc_driver_jar_uri    = ""

enable_glue_workflow_orchestration = false
enable_glue_workflow_schedule      = false
glue_workflow_schedule_expression  = "cron(0 18 * * ? *)" # 2:00 AM Asia/Manila daily

git_repository_url = "https://git-codecommit.ap-southeast-1.amazonaws.com/v1/repos/cdcu"

enable_sagemaker_unified_studio = true
sagemaker_studio_user_profile_names = [
  "data-engineer-01",
  "data-engineer-02",
]
sagemaker_studio_space_instance_type     = "ml.t3.medium"
sagemaker_studio_space_volume_size_gb    = 5
sagemaker_studio_app_network_access_type = "VpcOnly"

# Sync repo-managed notebooks from S3 into SageMaker JupyterLab on app start.
enable_studio_notebook_autosync = true
studio_notebook_s3_uri          = "s3://bpims-cdcu-prod-data-lake/prod/sagemaker-notebooks/"
studio_notebook_local_path      = "$HOME/cdcu-managed/notebooks/"

enable_sagemaker_notebook_instance        = true
sagemaker_notebook_instance_name          = "cdcu-prod-notebook"
sagemaker_notebook_instance_type          = "ml.t3.medium"
sagemaker_notebook_volume_size_gb         = 5
sagemaker_notebook_direct_internet_access = "Disabled"
sagemaker_notebook_root_access            = "Disabled"

enable_sagemaker_matching_pipeline          = false
enable_sagemaker_matching_pipeline_schedule = false
enable_sagemaker_matching_pipeline_glue_success_event = false
sagemaker_matching_pipeline_schedule_expression = "rate(1 day)"
sagemaker_matching_pipeline_processing_image_uri = ""
enable_sagemaker_processing_image_repository = false
enable_sagemaker_processing_image_build = false
sagemaker_processing_image_repository_name = "cdcu-prod-sagemaker-processing"
sagemaker_processing_image_tag = "py312"
sagemaker_processing_image_force_delete = false
sagemaker_matching_pipeline_processing_script_name = "matching_prod.py"
sagemaker_matching_pipeline_runner_script_name = "run_matching_prod.py"
sagemaker_matching_pipeline_wheelhouse_s3_uri = ""
sagemaker_matching_pipeline_instance_type          = "ml.m5.2xlarge"
sagemaker_matching_pipeline_instance_count         = 1
sagemaker_matching_pipeline_volume_size_gb         = 30
sagemaker_matching_pipeline_max_runtime_seconds    = 14400
sagemaker_matching_pipeline_standardized_s3_uri    = ""
sagemaker_matching_pipeline_output_s3_uri          = ""

enable_quicksight              = false
quicksight_admin_principal_arn = ""
quicksight_spice_capacity_gb   = 10

# IAM/RBAC is managed by the modules/iam module using the ST-CDCU prefix.
# manage_iam is a deprecated compatibility flag and has no effect.
manage_iam                = false
terraform_lock_table_name = "cdcu-terraform-locks-prod"

# Client-managed baseline inputs from BPI MS / manual setup.
existing_quicksight_access_role_arn = ""
existing_kms_key_arn                = "arn:aws:kms:ap-southeast-1:123456789012:key/00000000-0000-0000-0000-000000000000"
existing_security_group_id          = "sg-0123456789abcdef0"
