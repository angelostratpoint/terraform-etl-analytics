# Terraform state files
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform plan files
*.tfplan
*.plan
tfplan

# Terraform directory
.terraform/

# Terraform variable files (exclude real tfvars, keep examples)
*.tfvars
!*.tfvars.example

# Crash log files
crash.log
crash.*.log

# Sensitive files
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials

# Local sandbox fixtures and CLI helper payloads
local-fixtures/
dummy_*.csv
environments/*/lf-*.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
tmp/
temp/
versions.json
tmp_delete*.json

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Artifact placeholder files (keep READMEs, ignore .gitkeep in non-empty dirs)
artifacts/**/.gitkeep
